rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global Security Helpers ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isMeetingParticipant(meetingId) {
      let meeting = get(/databases/$(database)/documents/meetings/$(meetingId));
      return meeting != null && (
        meeting.data.organizerId == request.auth.uid
        || (meeting.data.coHosts != null && meeting.data.coHosts.hasAny([request.auth.uid]))
        || (meeting.data.participants != null && meeting.data.participants.hasAny([request.auth.uid]))
      );
    }

    function isScheduledMeetingParticipant(meetingId) {
      let meeting = get(/databases/$(database)/documents/scheduled_meetings/$(meetingId));
      return meeting != null && (
        meeting.data.organizerId == request.auth.uid
        || (meeting.data.coHosts != null && meeting.data.coHosts.hasAny([request.auth.uid]))
        || (meeting.data.participants != null && meeting.data.participants.hasAny([request.auth.uid]))
      );
    }

    function isMeetingModerator(meetingId) {
      let meeting = get(/databases/$(database)/documents/meetings/$(meetingId));
      return meeting != null && (
        meeting.data.organizerId == request.auth.uid
        || (meeting.data.coHosts != null && meeting.data.coHosts.hasAny([request.auth.uid]))
      );
    }

    // ── Meetings ──────────────────────────────────────────────────────────
    match /meetings/{meetingId} {
      // Tout utilisateur authentifié peut lire/chercher une réunion (pour la joindre)
      allow read: if isSignedIn();

      // Création : l'organisateur doit être authentifié et s'auto-déclarer
      allow create: if isSignedIn()
                    && request.resource.data.organizerId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.participants is list;

      // Update : host/co-host peuvent tout modifier (organizerId inchangé) ;
      // participants peuvent s'ajouter/se retirer/gérer le re-join (no-op)
      allow update: if isSignedIn()
                    && (
                      // Case 1: Host / Co-host updates
                      ((resource.data.organizerId == request.auth.uid
                        || (resource.data.coHosts != null && resource.data.coHosts.hasAny([request.auth.uid])))
                       && request.resource.data.organizerId == resource.data.organizerId)
                      ||
                      // Case 2: Participant self-management — only `participants` field
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
                       && request.resource.data.organizerId == resource.data.organizerId
                       && (
                         // Add self (size +1)
                         (request.resource.data.participants.hasAll(resource.data.participants)
                          && request.resource.data.participants.size() == resource.data.participants.size() + 1
                          && request.resource.data.participants.hasAny([request.auth.uid]))
                         ||
                         // Remove self (size -1)
                         (resource.data.participants.hasAll(request.resource.data.participants)
                          && resource.data.participants.size() == request.resource.data.participants.size() + 1
                          && resource.data.participants.hasAny([request.auth.uid]))
                         ||
                         // Re-join (no-op: arrayUnion on existing UID keeps size constant)
                         (request.resource.data.participants.hasAll(resource.data.participants)
                          && resource.data.participants.hasAll(request.resource.data.participants)
                          && request.resource.data.participants.size() == resource.data.participants.size()
                          && request.resource.data.participants.hasAny([request.auth.uid])
                          && resource.data.participants.hasAny([request.auth.uid]))
                       ))
                    );

      allow delete: if isSignedIn()
                    && resource.data.organizerId == request.auth.uid;

      // Chat
      match /chat/{messageId} {
        allow read: if isSignedIn() && isMeetingParticipant(meetingId);
        allow create: if isSignedIn()
                      && isMeetingParticipant(meetingId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }

      // Drawings (whiteboard)
      match /drawings/{drawingId} {
        allow read: if isSignedIn() && isMeetingParticipant(meetingId);
        allow create: if isSignedIn()
                      && isMeetingParticipant(meetingId)
                      && request.resource.data.senderId == request.auth.uid
                      && (
                        (request.resource.data.keys().hasAll(['x1', 'y1', 'x2', 'y2', 'color', 'senderId', 'timestamp'])
                         && request.resource.data.x1 is number
                         && request.resource.data.y1 is number
                         && request.resource.data.x2 is number
                         && request.resource.data.y2 is number
                         && request.resource.data.color is string
                         && request.resource.data.color.size() <= 64
                         && (request.resource.data.timestamp is timestamp || request.resource.data.timestamp == request.time))
                        ||
                        (request.resource.data.keys().hasAll(['action', 'senderId', 'timestamp'])
                         && request.resource.data.action == 'clear'
                         && (request.resource.data.timestamp is timestamp || request.resource.data.timestamp == request.time))
                      );
        allow update, delete: if false;
      }

      // Presence
      match /presence/{userId} {
        allow read: if isSignedIn() && isMeetingParticipant(meetingId);
        allow write: if isSignedIn()
                     && request.auth.uid == userId
                     && isMeetingParticipant(meetingId)
                     && (
                       (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
                       && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
                       && (!('micOn' in request.resource.data) || request.resource.data.micOn is bool)
                       && (!('camOn' in request.resource.data) || request.resource.data.camOn is bool)
                       && (!('handRaised' in request.resource.data) || request.resource.data.handRaised is bool)
                       && (!('isSpeaking' in request.resource.data) || request.resource.data.isSpeaking is bool)
                       && (!('joinedAt' in request.resource.data) || (request.resource.data.joinedAt is timestamp || request.resource.data.joinedAt == request.time))
                     );
      }

      // Attendance
      match /attendance/{userId} {
        allow read: if isSignedIn() && isMeetingParticipant(meetingId);
        allow write: if isSignedIn() && request.auth.uid == userId && isMeetingParticipant(meetingId);
      }

      // Camera/mic control signals
      match /camOffSignals/{signalId} {
        allow read, write: if isSignedIn() && isMeetingParticipant(meetingId);
      }

      // Meeting reports (sub-collection)
      match /reports/{reportId} {
        allow read: if isSignedIn() && isMeetingParticipant(meetingId);
        allow write: if isSignedIn() && isMeetingParticipant(meetingId)
                     && (resource == null
                        ? request.resource.data.hostId == request.auth.uid
                        : resource.data.hostId == request.auth.uid);
      }

      // Fichiers partagés dans le chat (métadonnées ; binaire dans Storage)
      match /files/{fileId} {
        allow read: if isSignedIn() && isMeetingParticipant(meetingId);
        allow create: if isSignedIn() && isMeetingParticipant(meetingId)
                      && request.resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && isMeetingParticipant(meetingId)
                      && (resource.data.senderId == request.auth.uid
                          || isMeetingModerator(meetingId));
      }

      // Participants expulsés par l'hôte : lecture de SA fiche uniquement ;
      // écriture réservée aux modérateurs. Permet une déconnexion immédiate.
      match /kicked/{userId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && isMeetingModerator(meetingId);
      }

      // Salle d'attente : chacun déclare SA fiche ; l'hôte/co-hôte admet
      // (suppression) ou refuse (decision = denied).
      match /waiting/{userId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId || isMeetingParticipant(meetingId)
        );
        allow create: if isSignedIn() && request.auth.uid == userId
                      && (!('decision' in request.resource.data));
        allow update, delete: if isSignedIn() && (
          request.auth.uid == userId || isMeetingModerator(meetingId)
        );
      }
    }

    // ── Sondages & Q&A (temps réel, tous les participants) ────────────────
    match /polls/{pollId} {
      allow read: if isSignedIn() && isMeetingParticipant(resource.data.meetingId);
      allow create: if isSignedIn() && isMeetingParticipant(request.resource.data.meetingId);
      // Votes (transactions), clôture, suppression : tout participant de la
      // réunion ; la modération fine reste côté client (UI).
      allow update, delete: if isSignedIn()
                            && isMeetingParticipant(resource.data.meetingId);
    }

    match /qa_questions/{questionId} {
      allow read: if isSignedIn() && isMeetingParticipant(resource.data.meetingId);
      allow create: if isSignedIn() && isMeetingParticipant(request.resource.data.meetingId);
      allow update, delete: if isSignedIn()
                            && isMeetingParticipant(resource.data.meetingId);
    }

    // ── Scheduled Meetings ──────────────────────────────────────────────
    match /scheduled_meetings/{meetingId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.organizerId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.participants is list;

      // Update : organizer/co-host libre, participant self-management (avec re-join no-op)
      allow update: if isSignedIn()
                    && (
                      ((resource.data.organizerId == request.auth.uid
                        || (resource.data.coHosts != null && resource.data.coHosts.hasAny([request.auth.uid])))
                       && request.resource.data.organizerId == resource.data.organizerId)
                      ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
                       && request.resource.data.organizerId == resource.data.organizerId
                       && (
                         (request.resource.data.participants.hasAll(resource.data.participants)
                          && request.resource.data.participants.size() == resource.data.participants.size() + 1
                          && request.resource.data.participants.hasAny([request.auth.uid]))
                         ||
                         (resource.data.participants.hasAll(request.resource.data.participants)
                          && resource.data.participants.size() == request.resource.data.participants.size() + 1
                          && resource.data.participants.hasAny([request.auth.uid]))
                         ||
                         (request.resource.data.participants.hasAll(resource.data.participants)
                          && resource.data.participants.hasAll(request.resource.data.participants)
                          && request.resource.data.participants.size() == resource.data.participants.size()
                          && request.resource.data.participants.hasAny([request.auth.uid])
                          && resource.data.participants.hasAny([request.auth.uid]))
                       ))
                    );

      allow delete: if isSignedIn()
                    && resource.data.organizerId == request.auth.uid;

      match /chat/{messageId} {
        allow read: if isSignedIn() && isScheduledMeetingParticipant(meetingId);
        allow create: if isSignedIn()
                      && isScheduledMeetingParticipant(meetingId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }

      match /presence/{userId} {
        allow read: if isSignedIn() && isScheduledMeetingParticipant(meetingId);
        allow write: if isSignedIn()
                     && request.auth.uid == userId
                     && isScheduledMeetingParticipant(meetingId);
      }
    }

    // ── User profiles (CORRIGÉ — bugs #2 et #3) ──────────────────────────
    match /users/{userId} {
      // Lecture : tout utilisateur authentifié (nécessaire pour noms/photos dans les appels)
      allow read: if isSignedIn();

      // CREATE : l'utilisateur crée SON profil, isPro ne peut pas être true (anti-élévation)
      allow create: if isSignedIn()
                     && request.auth.uid == userId
                     && (!('isPro' in request.resource.data)
                         || request.resource.data.isPro == false);

      // UPDATE : l'utilisateur modifie SON profil, isPro ne peut pas être changé
      allow update: if isSignedIn()
                     && request.auth.uid == userId
                     && (!('isPro' in request.resource.data)
                         || request.resource.data.isPro == resource.data.isPro);

      // DELETE : l'utilisateur peut supprimer SON profil
      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Notes personnelles de réunion (historique « Notes »)
      match /notes/{noteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ── Meeting reports (top-level) ───────────────────────────────────────
    match /meeting_reports/{reportId} {
      allow read: if isSignedIn() && resource.data.hostId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.hostId == request.auth.uid;
    }

    // ── WebRTC signaling rooms ────────────────────────────────────────────
    match /webrtc_rooms/{roomId} {
      allow read, write: if isSignedIn() && isMeetingParticipant(roomId);

      match /offerCandidates/{id} {
        allow read, write: if isSignedIn() && isMeetingParticipant(roomId);
      }
      match /answerCandidates/{id} {
        allow read, write: if isSignedIn() && isMeetingParticipant(roomId);
      }
      match /reactions/{id} {
        allow read: if isSignedIn() && isMeetingParticipant(roomId);
        allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid && isMeetingParticipant(roomId);
      }
    }
  }
}
